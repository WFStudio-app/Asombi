# Normalize line endings
* text=auto eol=lf

# Shell scripts — always LF
*.sh text eol=lf
bin/wiz text eol=lf
bin/os text eol=lf

# Python
*.py text eol=lf

# TypeScript — явный язык для GitHub linguist (иначе .ts может не попасть в статистику)
*.ts text eol=lf linguist-language=TypeScript
*.tsx text eol=lf linguist-language=TypeScript
*.js text eol=lf linguist-detectable=false
truck/ts/** linguist-detectable=true

# JSON / YAML
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Binary
*.tar.gz binary
*.tar.xz binary
*.zip binary
*.png binary
*.jpg binary

# Roff man pages
*.1 text eol=lf linguist-detectable=false
